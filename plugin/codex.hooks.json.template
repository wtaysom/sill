{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__sill__(remember|remember_batch|remember_batch_raw)|Bash|exec|exec_command|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/attribution-check.py",
            "statusMessage": "Checking attribution claims"
          }
        ]
      },
      {
        "matcher": "mcp__sill__(remember|remember_batch|remember_batch_raw)|Bash|exec|exec_command|shell|shell_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/state-language-check.py",
            "statusMessage": "Checking state-language claims"
          }
        ]
      },
      {
        "matcher": "Bash|exec|exec_command|shell|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/shell-idiom-guard.py",
            "statusMessage": "Checking shell command for idiom traps",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/stored-slot-guard.py",
            "statusMessage": "Checking receipt-shaped ids against the store",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/tool-type-witness.py",
            "statusMessage": "Checking carrying-act claims",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/spontaneous-recall.py",
            "statusMessage": "Recalling relevant memory",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/response-patterns.py",
            "statusMessage": "Checking response patterns",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/track-reuse.py",
            "statusMessage": "Checking memory reuse",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/clear-handoff.py",
            "statusMessage": "Restoring /clear handoff context",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "{{SILL_PYTHON}} {{SILL_PLUGIN_DIR}}/hooks/write-recall.py",
            "statusMessage": "Recalling written context",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
